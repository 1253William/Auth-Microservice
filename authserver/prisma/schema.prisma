
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

model User {
  id  String @id @default(uuid())
  fullName  String
  email String  @unique
  phoneNumber String
  password  String
  role  Role  @default(PASSENGER)
  createdAt DateTime  @default(now())
  updateAt  DateTime @updatedAt
}